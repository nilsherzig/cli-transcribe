#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM_NAME="${0##*/}"
MODEL_NAME="large-v3-turbo-q8_0"
MODEL_FILE="ggml-${MODEL_NAME}.bin"
MODEL_DIR="${HOME}/.local/share/cli-transcribe"
DEFAULT_LANG="de"

# Silero VAD model used for the live streaming mode. whisper.cpp ships
# whisper-vad-speech-segments but no download helper, so we fetch it ourselves.
VAD_MODEL_NAME="silero-v5.1.2"
VAD_MODEL_FILE="ggml-${VAD_MODEL_NAME}.bin"
VAD_MODEL_URL="https://huggingface.co/ggml-org/whisper-vad/resolve/main/${VAD_MODEL_FILE}"

# Live mode tuning. The VAD knobs are overridable via environment so you can
# dial them in with your own voice without editing the script:
#   LIVE_MIN_SILENCE_MS  pause length (ms) that closes a segment.
#                        Higher = fewer, longer segments but risks dropping
#                        short speech islands. Lower = more, shorter segments.
#   LIVE_VAD_THRESHOLD   speech probability cutoff (0.0-1.0). Lower if quiet
#                        speech gets dropped, raise if noise is picked up.
LIVE_POLL_SECONDS=1.0   # how often we scan the recording for finished segments
LIVE_MIN_SILENCE_MS="${LIVE_MIN_SILENCE_MS:-500}"
LIVE_VAD_THRESHOLD="${LIVE_VAD_THRESHOLD:-0.5}"
LIVE_PAD_SECONDS=0.15   # padding added around each extracted segment

lang="$DEFAULT_LANG"
mic=""
input_file=""
copy_to_clipboard=false
explain_prefix=false
verbose=false
live=false
stop_on_stdin=false

# Set by run_live, consumed by main.
LIVE_TRANSCRIPT=""
AUDIO_CAPTURE_ARGS=()
RECORDING_SERVER_PID=""
RECORDING_SERVER_PORT=""
RECORDING_SERVER_PATH=""
RECORDING_SERVER_LOG=""

log() {
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

info() {
  printf '%s\n' "$*" >&2
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
$PROGRAM_NAME - Audio aufnehmen und mit whisper.cpp transkribieren

Usage:
  $PROGRAM_NAME [OPTIONS]
  $PROGRAM_NAME --list-mics
  $PROGRAM_NAME help

Options:
  --mic <device>        Mikrofon direkt oder als Teilstring angeben.
                        Beispiel: --mic "rode" matcht wie *rode*.
                        Wenn mehrere Mikrofone matchen, bricht das Programm mit Erklärung ab.
                        Ohne diese Option wird eine Auswahl mit fzf geöffnet.
                        Nicht kombinierbar mit --input-file.
  --input-file <path>   Audio-/Video-Datei transkribieren. Die Datei wird mit ffmpeg
                        in das benötigte Format (mono 16kHz PCM WAV) konvertiert.
                        Nicht kombinierbar mit --mic.
  --live                Live-Transkription: nimmt durchgehend auf und transkribiert
                        jeden an einer Sprechpause abgeschlossenen Abschnitt sofort
                        (Silero-VAD). Vorschau läuft auf stderr, der saubere
                        Gesamttext auf stdout. Nicht kombinierbar mit --input-file.
  --stop-on-stdin       Im Mikrofon-Modus eine Zeile von stdin zum Beenden lesen,
                        statt auf Enter in /dev/tty zu warten. Für Integrationen.
  --lang <lang>         Sprache für Whisper, Default: de
                        Beispiele: de, en, fr, auto
  --copy                Transcript nach Erstellung in die Zwischenablage kopieren.
  --explain-prefix      Transcript mit Kontext für Coding Agents ausgeben/kopieren.
  -v, --verbose         Ausführliche Ausgaben von ffmpeg und whisper-cli anzeigen.
  --list-mics           Verfügbare Mikrofone auflisten. Die ausgegebenen Namen können für --mic genutzt werden.
  -h, --help            Diese Hilfe anzeigen.

Examples:
  $PROGRAM_NAME
  $PROGRAM_NAME --live
  $PROGRAM_NAME --live --mic rode --copy
  $PROGRAM_NAME --mic alsa_input.pci-0000_0b_00.4.analog-stereo --lang de
  $PROGRAM_NAME --mic rode --copy
  $PROGRAM_NAME --copy --explain-prefix
  $PROGRAM_NAME --copy
  $PROGRAM_NAME --input-file ~/Videos/aufnahme.mp4 --lang de
  $PROGRAM_NAME --input-file ~/Downloads/podcast.mp3 --copy
  $PROGRAM_NAME --list-mics

Ablauf (Mikrofon-Modus):
  1. Du wählst ein Mikrofon aus oder gibst es via --mic an.
  2. ffmpeg nimmt auf; parallel lädt ein lokaler Whisper-Server das Model.
  3. Enter/Return beendet die Aufnahme (oder eine Zeile über stdin bei --stop-on-stdin).
  4. Der Whisper-Server transkribiert die Aufnahme und wird danach beendet.
  5. Das Transcript wird auf stdout ausgegeben.
     Script-Logs werden auf stderr ausgegeben.

Ablauf (--input-file Modus):
  1. Falls das Whisper-Model fehlt, wird es nach $MODEL_DIR heruntergeladen.
  2. Die Datei wird mit ffmpeg in mono 16kHz PCM WAV konvertiert.
  3. whisper-cli transkribiert die Audiodatei.
  4. Das Transcript wird auf stdout ausgegeben.
     Script-Logs werden auf stderr ausgegeben.

Ablauf (--live Modus):
  1. Falls Whisper- oder VAD-Model fehlen, werden sie nach $MODEL_DIR geladen.
  2. Du wählst ein Mikrofon aus oder gibst es via --mic an.
  3. ffmpeg nimmt durchgehend auf (raw PCM).
  4. In einem Intervall sucht das Silero-VAD abgeschlossene Sprech-Segmente.
  5. Jedes fertige Segment wird einzeln transkribiert und als
     Vorschau auf stderr ausgegeben.
  6. Enter/Return beendet die Aufnahme; das letzte Segment wird finalisiert.
  7. Der zusammengesetzte Gesamttext wird auf stdout ausgegeben.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Benötigtes Kommando fehlt: $1"
}

ffmpeg_loglevel() {
  if [[ "$verbose" == true ]]; then
    printf 'warning\n'
  else
    printf 'error\n'
  fi
}

# Wartet bis $1 (pid) terminiert ist, max. $2 * 100ms.
# 0 = Prozess beendet, 1 = noch am Leben.
wait_for_pid_exit() {
  local pid="$1" max_iters="$2" i=0
  while [[ $i -lt $max_iters ]]; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      wait "$pid" >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

format_transcript() {
  local transcript="$1"

  if [[ "$explain_prefix" != true ]]; then
    printf '%s\n' "$transcript"
    return 0
  fi

  cat <<EOF
Dies ist ein Transkript von einem Menschen, der gerade eine Aufgabe oder Eingabe diktiert hat. Einige Wörter, Namen oder Details können durch die automatische Transkription ungenau sein. Bitte frage nach, wenn etwas unklar ist.

Hier ist das Transkript:

$transcript
EOF
}

is_macos() {
  [[ "$(uname -s)" == Darwin ]]
}

list_mics() {
  if is_macos; then
    require_command ffmpeg
    # AVFoundation lists video devices first; its audio indices are independent.
    # ffmpeg exits non-zero after listing because no input was opened.
    local line audio_devices=false
    while IFS= read -r line; do
      if [[ "$line" == *"AVFoundation audio devices:"* ]]; then
        audio_devices=true
        continue
      fi
      if [[ "$audio_devices" == true && "$line" =~ \[([0-9]+)\]\ (.+)$ ]]; then
        printf ':%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
      fi
    done < <(ffmpeg -hide_banner -f avfoundation -list_devices true -i '' 2>&1 || true)
  else
    require_command pactl
    pactl list short sources | awk '$2 !~ /\.monitor$/ { print $2 }'
  fi
}

# Set the input arguments for both the regular and live recording paths.
set_audio_capture_args() {
  local selected_mic="$1"
  if is_macos; then
    AUDIO_CAPTURE_ARGS=(-f avfoundation -i "${selected_mic%% *}")
  else
    AUDIO_CAPTURE_ARGS=(-f pulse -i "$selected_mic")
  fi
}

ensure_model() {
  local model_path="$MODEL_DIR/$MODEL_FILE"

  if [[ -f "$model_path" ]]; then
    log "Whisper-Model gefunden: $model_path"
    printf '%s\n' "$model_path"
    return 0
  fi

  require_command whisper-cpp-download-ggml-model

  info "Whisper-Model fehlt: $model_path"
  info "Lade Model '$MODEL_NAME' nach $MODEL_DIR herunter. Das kann eine Weile dauern ..."
  mkdir -p "$MODEL_DIR"
  (
    cd "$MODEL_DIR"
    whisper-cpp-download-ggml-model "$MODEL_NAME"
  ) >&2

  [[ -f "$model_path" ]] || die "Model wurde nicht unter $model_path gefunden. Bitte Download-Ausgabe prüfen."
  info "Download abgeschlossen: $model_path"
  printf '%s\n' "$model_path"
}

ensure_vad_model() {
  local model_path="$MODEL_DIR/$VAD_MODEL_FILE"

  if [[ -f "$model_path" ]]; then
    log "VAD-Model gefunden: $model_path"
    printf '%s\n' "$model_path"
    return 0
  fi

  require_command curl

  info "VAD-Model fehlt: $model_path"
  info "Lade VAD-Model '$VAD_MODEL_NAME' herunter ..."
  mkdir -p "$MODEL_DIR"
  curl -fSL --progress-bar -o "$model_path" "$VAD_MODEL_URL" >&2 \
    || die "Download des VAD-Models fehlgeschlagen: $VAD_MODEL_URL"

  [[ -s "$model_path" ]] || die "VAD-Model wurde nicht heruntergeladen: $model_path"
  info "VAD-Model gespeichert: $model_path"
  printf '%s\n' "$model_path"
}

resolve_mic_query() {
  local query="$1"
  local -a exact_matches substring_matches

  # AVFoundation accepts :N directly; listing devices is slow on macOS.
  if is_macos && [[ "$query" =~ ^:[0-9]+$ ]]; then
    printf '%s\n' "$query"
    return 0
  fi

  mapfile -t exact_matches < <(list_mics | grep -Fxi -- "$query" || true)
  if [[ ${#exact_matches[@]} -eq 1 ]]; then
    printf '%s\n' "${exact_matches[0]}"
    return 0
  fi

  mapfile -t substring_matches < <(list_mics | grep -Fi -- "$query" || true)
  case "${#substring_matches[@]}" in
    0)
      die "Kein Mikrofon matcht --mic '$query' (*$query*). Nutze --list-mics für gültige Werte."
      ;;
    1)
      log "--mic '$query' wurde auf '${substring_matches[0]}' aufgelöst."
      printf '%s\n' "${substring_matches[0]}"
      ;;
    *)
      {
        printf 'Error: --mic '\''%s'\'' ist nicht eindeutig. Folgende Mikrofone matchen *%s*:\n' "$query" "$query"
        printf '  %s\n' "${substring_matches[@]}"
        printf 'Bitte nutze einen genaueren Suchbegriff oder einen vollständigen Namen aus --list-mics.\n'
      } >&2
      exit 1
      ;;
  esac
}

select_mic() {
  if [[ -n "$mic" ]]; then
    resolve_mic_query "$mic"
    return 0
  fi

  require_command fzf

  local selected
  selected="$(list_mics | fzf --prompt='Mikrofon auswählen: ' --height=40% --border)" || die "Keine Mikrofon-Auswahl getroffen."
  [[ -n "$selected" ]] || die "Keine Mikrofon-Auswahl getroffen."
  printf '%s\n' "$selected"
}

process_input_file() {
  local input_path="$1"
  local output_path="$2"

  [[ -f "$input_path" ]] || die "Datei nicht gefunden: $input_path"

  log "Konvertiere '$input_path' nach mono 16kHz PCM WAV ..."

  ffmpeg -hide_banner -loglevel "$(ffmpeg_loglevel)" -y \
    -i "$input_path" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$output_path" 2>&1 || die "ffmpeg Konvertierung fehlgeschlagen für: $input_path"

  [[ -s "$output_path" ]] || die "Konvertierte Datei ist leer: $output_path"
  log "Konvertierung abgeschlossen: $output_path"
}

record_audio() {
  local selected_mic="$1"
  local audio_file="$2"

  log "Aufnahme startet über Mikrofon: $selected_mic"
  if [[ "$stop_on_stdin" == true ]]; then
    info "Aufnahme läuft. Warte auf ein Stop-Signal über stdin oder Ctrl-C zum Abbrechen."
  else
    info "Aufnahme läuft. Drücke Enter/Return zum Beenden oder Ctrl-C zum Abbrechen."
  fi

  set_audio_capture_args "$selected_mic"
  ffmpeg -hide_banner -loglevel "$(ffmpeg_loglevel)" -y \
    "${AUDIO_CAPTURE_ARGS[@]}" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$audio_file" < /dev/null &

  local ffmpeg_pid=$!

  stop_recording() {
    local first_signal="${1:-INT}"
    # Eskalation: zuerst $first_signal (z.B. SIGINT), dann SIGTERM, dann SIGKILL.
    # PulseAudio/ffmpeg kann bei SIGINT hängen, daher mit timeout je Stufe.
    local -a escalation=("$first_signal:20" "TERM:10" "KILL:10")
    local step signal iters
    for step in "${escalation[@]}"; do
      signal="${step%:*}"
      iters="${step#*:}"
      if ! kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
        wait "$ffmpeg_pid" >/dev/null 2>&1 || true
        return 0
      fi
      [[ "$signal" == "$first_signal" ]] || log "ffmpeg reagiert nicht, sende SIG$signal ..."
      kill -"$signal" "$ffmpeg_pid" >/dev/null 2>&1 || true
      wait_for_pid_exit "$ffmpeg_pid" "$iters" && return 0
    done
  }

  abort_recording() {
    trap - INT TERM
    printf '\n' >&2
    log "Abbruch angefordert. Stoppe Aufnahme und beende Programm ..."
    stop_recording INT
    exit 130
  }

  trap abort_recording INT TERM

  # Also notice early capture failures (e.g. an invalid AVFoundation index)
  # instead of waiting forever for Enter on a recording that never started.
  local read_status
  while kill -0 "$ffmpeg_pid" >/dev/null 2>&1; do
    if [[ "$stop_on_stdin" == true ]]; then
      if read -r -t 0.1 _; then
        break
      else
        read_status=$?
      fi
    else
      if read -r -t 0.1 _ < /dev/tty; then
        break
      else
        read_status=$?
      fi
    fi
    # read returns >128 on timeout; EOF should stop the recording as before.
    [[ "$read_status" -gt 128 ]] || break
  done

  stop_recording INT
  trap - INT TERM

  [[ -s "$audio_file" ]] || die "Aufnahme-Datei ist leer oder wurde nicht erstellt: $audio_file"
  log "Aufnahme gespeichert: $audio_file"
}

# Load the model concurrently with recording. The private path distinguishes
# this server from any other process listening on the same port.
start_recording_server() {
  local work_dir="$1" model_path
  RECORDING_SERVER_PORT=$((49152 + ((RANDOM << 15 | RANDOM) % 16384)))
  RECORDING_SERVER_PATH="/${work_dir##*/}"
  RECORDING_SERVER_LOG="$work_dir/whisper-server.log"
  (
    model_path="$(ensure_model)"
    exec whisper-server -m "$model_path" -l "$lang" \
      --host 127.0.0.1 --port "$RECORDING_SERVER_PORT" \
      --request-path "$RECORDING_SERVER_PATH" > "$RECORDING_SERVER_LOG" 2>&1
  ) &
  RECORDING_SERVER_PID=$!
}

stop_recording_server() {
  [[ -n "$RECORDING_SERVER_PID" ]] || return 0
  kill -TERM "$RECORDING_SERVER_PID" 2>/dev/null || true
  if ! wait_for_pid_exit "$RECORDING_SERVER_PID" 30; then
    kill -KILL "$RECORDING_SERVER_PID" 2>/dev/null || true
    wait "$RECORDING_SERVER_PID" 2>/dev/null || true
  fi
  RECORDING_SERVER_PID=""
}

wait_for_recording_server() {
  local url="http://127.0.0.1:$RECORDING_SERVER_PORT$RECORDING_SERVER_PATH/health"
  local i
  for ((i=0; i<3000; i++)); do
    if ! kill -0 "$RECORDING_SERVER_PID" 2>/dev/null; then
      die "Whisper-Server wurde nicht gestartet. Details: $RECORDING_SERVER_LOG"
    fi
    if curl --noproxy '*' -fsS --connect-timeout 1 --max-time 1 "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  die "Whisper-Server wurde nicht rechtzeitig bereit. Details: $RECORDING_SERVER_LOG"
}

run_server_transcription() {
  local audio_file="$1" output_base="$2"
  local transcript_file="${output_base}.txt"
  wait_for_recording_server
  log "Transkribiere mit vorbereitetem Whisper-Server, Sprache: $lang"
  if ! curl --noproxy '*' -fsS --max-time 600 \
    -F "file=@${audio_file};type=audio/wav" \
    -F "language=$lang" -F response_format=text -F no_timestamps=true \
    "http://127.0.0.1:$RECORDING_SERVER_PORT$RECORDING_SERVER_PATH/inference" \
    > "$transcript_file"; then
    die "Whisper-Server ist fehlgeschlagen. Details: $RECORDING_SERVER_LOG"
  fi
  [[ -f "$transcript_file" ]] || die "Transcript wurde nicht erstellt: $transcript_file"
  log "Transcript gespeichert: $transcript_file"
  printf '%s\n' "$transcript_file"
}

run_transcription() {
  local model_path="$1"
  local audio_file="$2"
  local output_base="$3"
  local transcript_file="${output_base}.txt"

  log "Transkribiere mit whisper-cli, Sprache: $lang"
  local -a args=(-m "$model_path" -f "$audio_file" -l "$lang" -otxt -of "$output_base" -nt)
  if [[ "$verbose" == true ]]; then
    args+=(--print-colors --print-confidence)
    whisper-cli "${args[@]}" >&2 || die "whisper-cli ist fehlgeschlagen."
  else
    whisper-cli "${args[@]}" >/dev/null 2>&1 || die "whisper-cli ist fehlgeschlagen. Nutze -v für Details."
  fi

  [[ -f "$transcript_file" ]] || die "Transcript wurde nicht erstellt: $transcript_file"
  log "Transcript gespeichert: $transcript_file"
  printf '%s\n' "$transcript_file"
}

# Live-Transkription: nimmt durchgehend als raw PCM auf, sucht per Silero-VAD
# abgeschlossene Sprech-Segmente und transkribiert jedes einzeln.
# Ergebnis landet in der globalen Variable LIVE_TRANSCRIPT.
run_live() {
  local model_path="$1" vad_path="$2" selected_mic="$3" work_dir="$4"
  local raw_file="$work_dir/audio.raw"
  local snapshot="$work_dir/snapshot.wav"
  local -a transcript_parts=()
  local segments_printed=0

  log "Live-Transkription über Mikrofon: $selected_mic (Sprache: $lang)"
  info "Live-Transkription läuft. Sprich los; eine kurze Pause schließt ein Segment ab."
  info "Drücke Enter/Return zum Beenden oder Ctrl-C zum Abbrechen."

  # ffmpeg schreibt headerloses raw PCM. Ein wachsender WAV hätte eine ungültige
  # Header-Länge, solange ffmpeg läuft; raw PCM lesen wir verlässlich bis EOF.
  set_audio_capture_args "$selected_mic"
  ffmpeg -hide_banner -loglevel "$(ffmpeg_loglevel)" -y \
    "${AUDIO_CAPTURE_ARGS[@]}" \
    -ac 1 -ar 16000 -f s16le \
    "$raw_file" < /dev/null &
  local ffmpeg_pid=$!

  live_cleanup() {
    kill -INT "$ffmpeg_pid" >/dev/null 2>&1 || true
    wait_for_pid_exit "$ffmpeg_pid" 20 || kill -KILL "$ffmpeg_pid" >/dev/null 2>&1 || true
  }

  abort_live() {
    trap - INT TERM
    printf '\n' >&2
    log "Abbruch angefordert. Stoppe Live-Transkription ..."
    live_cleanup
    exit 130
  }
  trap abort_live INT TERM

  # Verarbeitet neu abgeschlossene Segmente. $1=true finalisiert auch das letzte
  # (nur beim Stop), sonst bleibt das letzte Segment offen, da es noch wachsen kann.
  process_live_segments() {
    local finalize_last="$1"
    [[ -s "$raw_file" ]] || return 0

    # Snapshot mit gültigem WAV-Header aus dem bisher aufgenommenen raw PCM bauen.
    ffmpeg -hide_banner -loglevel error -y \
      -f s16le -ar 16000 -ac 1 -i "$raw_file" -c:a pcm_s16le "$snapshot" 2>/dev/null || return 0

    # Mit =() initialisieren: unter set -u gilt ein nur deklariertes Array sonst
    # als "unset" und ${#starts[@]} würde fehlschlagen, wenn kein Segment kommt.
    local starts=() ends=()
    local line
    while IFS= read -r line; do
      # Format: "Speech segment N: start = A, end = B" (Werte in Centisekunden).
      [[ "$line" =~ start\ =\ ([0-9.]+),\ end\ =\ ([0-9.]+) ]] || continue
      starts+=("${BASH_REMATCH[1]}")
      ends+=("${BASH_REMATCH[2]}")
    done < <(whisper-vad-speech-segments -f "$snapshot" -vm "$vad_path" \
               -vsd "$LIVE_MIN_SILENCE_MS" -vt "$LIVE_VAD_THRESHOLD" --no-prints 2>/dev/null)

    local total=${#starts[@]}
    local limit=$total
    [[ "$finalize_last" == true ]] || limit=$((total - 1))

    local i start_s end_s seg text
    for (( i = segments_printed; i < limit; i++ )); do
      start_s=$(awk "BEGIN{v=${starts[i]}/100-${LIVE_PAD_SECONDS}; if(v<0)v=0; printf \"%.2f\", v}")
      end_s=$(awk "BEGIN{printf \"%.2f\", ${ends[i]}/100+${LIVE_PAD_SECONDS}}")
      seg="$work_dir/seg.wav"
      if ffmpeg -hide_banner -loglevel error -y -i "$snapshot" -ss "$start_s" -to "$end_s" "$seg" 2>/dev/null; then
        text="$(whisper-cli -m "$model_path" -f "$seg" -l "$lang" -nt -np 2>/dev/null \
                  | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ -n "$text" ]]; then
          info "  » $text"
          transcript_parts+=("$text")
        fi
      fi
      rm -f "$seg"
      segments_printed=$((i + 1))
    done
  }

  # read -t dient gleichzeitig als Poll-Intervall und als Enter-Erkennung.
  while kill -0 "$ffmpeg_pid" >/dev/null 2>&1; do
    process_live_segments false
    if read -r -t "$LIVE_POLL_SECONDS" _ < /dev/tty; then
      break
    fi
  done

  trap - INT TERM
  log "Stoppe Aufnahme, finalisiere Transkript ..."
  live_cleanup
  process_live_segments true

  [[ ${#transcript_parts[@]} -gt 0 ]] || die "Keine Sprache erkannt. Nichts zu transkribieren."

  local IFS=' '
  LIVE_TRANSCRIPT="${transcript_parts[*]}"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      help|-h|--help)
        usage
        exit 0
        ;;
      --list-mics|list-mics)
        list_mics
        exit 0
        ;;
      --mic)
        [[ $# -ge 2 ]] || die "--mic benötigt einen Wert."
        [[ -z "$input_file" ]] || die "--mic und --input-file können nicht kombiniert werden."
        mic="$2"
        shift 2
        ;;
      --input-file)
        [[ $# -ge 2 ]] || die "--input-file benötigt einen Wert."
        [[ -z "$mic" ]] || die "--mic und --input-file können nicht kombiniert werden."
        [[ "$live" != true ]] || die "--live und --input-file können nicht kombiniert werden."
        [[ "$stop_on_stdin" != true ]] || die "--input-file und --stop-on-stdin können nicht kombiniert werden."
        input_file="$2"
        shift 2
        ;;
      --live)
        [[ -z "$input_file" ]] || die "--live und --input-file können nicht kombiniert werden."
        [[ "$stop_on_stdin" != true ]] || die "--live und --stop-on-stdin können nicht kombiniert werden."
        live=true
        shift
        ;;
      --stop-on-stdin)
        [[ -z "$input_file" ]] || die "--input-file und --stop-on-stdin können nicht kombiniert werden."
        [[ "$live" != true ]] || die "--live und --stop-on-stdin können nicht kombiniert werden."
        stop_on_stdin=true
        shift
        ;;
      --lang)
        [[ $# -ge 2 ]] || die "--lang benötigt einen Wert."
        lang="$2"
        shift 2
        ;;
      --copy)
        copy_to_clipboard=true
        shift
        ;;
      --explain-prefix)
        explain_prefix=true
        shift
        ;;
      -v|--verbose)
        verbose=true
        shift
        ;;
      *)
        die "Unbekannte Option: $1. Nutze --help."
        ;;
    esac
  done
}

main() {
  parse_args "$@"

  require_command ffmpeg
  if [[ -z "$input_file" && "$live" != true ]]; then
    require_command whisper-server
    require_command curl
  else
    require_command whisper-cli
  fi

  if [[ "$live" == true ]]; then
    require_command whisper-vad-speech-segments
  fi

  if [[ "$copy_to_clipboard" == true ]]; then
    if is_macos; then
      require_command pbcopy
    else
      require_command wl-copy
    fi
  fi

  local model_path vad_path work_dir audio_file output_base transcript_file transcript_output selected_mic
  work_dir="$(mktemp -d -t cli-transcribe.XXXXXX)"
  audio_file="$work_dir/audio.wav"
  output_base="$work_dir/transcript"

  log "Temporärer Arbeitsordner: $work_dir"

  if [[ "$live" == true ]]; then
    model_path="$(ensure_model)"
    vad_path="$(ensure_vad_model)"
    selected_mic="$(select_mic)"
    run_live "$model_path" "$vad_path" "$selected_mic" "$work_dir"
    transcript_output="$(format_transcript "$LIVE_TRANSCRIPT")"
  elif [[ -n "$input_file" ]]; then
    model_path="$(ensure_model)"
    process_input_file "$input_file" "$audio_file"
    transcript_file="$(run_transcription "$model_path" "$audio_file" "$output_base")"
    transcript_output="$(format_transcript "$(<"$transcript_file")")"
  else
    selected_mic="$(select_mic)"
    start_recording_server "$work_dir"
    trap stop_recording_server EXIT
    record_audio "$selected_mic" "$audio_file"
    transcript_file="$(run_server_transcription "$audio_file" "$output_base")"
    stop_recording_server
    if [[ "$verbose" == true ]]; then
      cat "$RECORDING_SERVER_LOG" >&2
    fi
    trap - EXIT
    transcript_output="$(format_transcript "$(<"$transcript_file")")"
  fi

  if [[ "$copy_to_clipboard" == true ]]; then
    if is_macos; then
      printf '%s' "$transcript_output" | pbcopy
    else
      wl-copy <<< "$transcript_output"
    fi
    log "Transcript wurde in die Zwischenablage kopiert."
  fi

  printf '%s\n' "$transcript_output"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
